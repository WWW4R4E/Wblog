pub fn ThemeSwitch(ctx: *zx.ComponentCtx(struct {})) !zx.Component {
    const dark = zx.client.eval(u32, "window.matchMedia('(prefers-color-scheme: dark)').matches ? 1 : 0") catch 0;
    const is_dark = ctx.state(bool, dark == 1);
    applyTheme(is_dark.get());
    return (
        <div @allocator={ctx.allocator}>
            <div class="theme-toggle-section">
                <label class="app-switch">
                    <input type="checkbox" checked={is_dark.get()} onchange={ctx.bind(changeTheme)} />
                    <div class="app-switch-view"></div>
                </label>
                {if (is_dark.get()) (
                    <svg class="theme-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                ) else (
                    <svg class="theme-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                    </svg>
                )}
            </div>
        </div>
    );
}
fn changeTheme(e: *zx.client.Event.Stateful) void {
    const is_dark = e.state(bool);
    is_dark.set(!is_dark.get());
    applyTheme(is_dark.get());
}

fn applyTheme(dark: bool) void {
    if (dark) {
        zx.client.eval(void, "document.body.classList.add('dark-theme')") catch {};
        zx.client.eval(void, "document.documentElement.setAttribute('data-theme', 'dark')") catch {};
    } else {
        zx.client.eval(void, "document.body.classList.remove('dark-theme')") catch {};
        zx.client.eval(void, "document.documentElement.setAttribute('data-theme', 'light')") catch {};
    }
}

const zx = @import("zx");
const std = @import("std");
