pub fn BlogHeader(allocator: zx.Allocator) zx.Component {

    return (
        <header @allocator={allocator} class="blog-header">
            <div class="header-container">
                <div class="logo-section">
                    <a href="/" class="logo">Wblog</a>
                </div>

                <nav class="nav-menu">
                    <a href="/" class="nav-link">首页</a>
                    <a href="/archive" class="nav-link">归档</a>
                    <a href="/tags" class="nav-link">标签</a>
                </nav> 

                <div class="header-controls">
                    <div class="theme-toggle-section">
                        <ThemeSwitch @rendering={.client} />
                    </div> 
                </div>
            </div>
        </header>
    );
}

const zx = @import("zx");
pub const ThemeSwitch = @import("./client.zig").ThemeSwitch;
